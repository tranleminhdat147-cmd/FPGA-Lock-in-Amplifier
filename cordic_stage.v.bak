module cordic_stage # (parameter DATA_WIDTH = 12,
                       parameter i = 0)
							  (input clk,,
							   input signed [DATA_WIDTH-1:0] x_in,
							   input signed [DATA_WIDTH-1:0] y_in,
								input signed [DATA_WIDTH-1:0] z_in,
								output signed [DATA_WIDTH-1:0] x_out,
								output signed [DATA_WIDTH-1:0] y_out,
								output signed [DATA_WIDTH-1:0] z_out);

function [DATA_WIDTH-1:0] atan;
    input [3:0] stage;
    case (stage)
        4'd0:  atan = 16'h2000; // 45.000°
        4'd1:  atan = 16'h12E4; // 26.565°
        4'd2:  atan = 16'h09FB; // 14.036°
        4'd3:  atan = 16'h0511; // 7.125°
        4'd4:  atan = 16'h028B; // 3.576°
        4'd5:  atan = 16'h0146; // 1.790°
        4'd6:  atan = 16'h00A3; // 0.895°
        4'd7:  atan = 16'h0051; // 0.448°
        4'd8:  atan = 16'h0029; // 0.224°
        4'd9:  atan = 16'h0014; // 0.112°
        4'd10: atan = 16'h000A; // 0.056°
        4'd11: atan = 16'h0005; // 0.028°
        default: atan = 16'h0000;
    endcase
endfunction 

always @ (posedge clk) begin
    if (y_in[DATA_WIDTH-1] == 1'b1) begin
	     x_out <= x_in + (y_in >> i);
		  y_out <= y_in - (x_in >> i);
		  z_in <= z_in + atan(i);
	 end
	 else begin
	     x_out <= x_in - (y_in >> i);
		  y_out <= y_in + (x_in >> i);
		  z_in <= z_in - atan(i);
	end
end


	 