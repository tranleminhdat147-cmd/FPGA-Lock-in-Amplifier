`timescale 1ns/1ps

module tb_lut_sincos;

    // Parameters
    parameter PHASE_WIDTH = 32;
    parameter ADDR_WIDTH  = 10;
    parameter DATA_WIDTH  = 12;
    parameter CLK_PERIOD  = 20;     // 50 MHz clock

    // Testbench signals
    reg                      clk;
    reg                      rst;
    reg  [PHASE_WIDTH-1:0]   phase_step;

    wire [DATA_WIDTH-1:0]    sine_wave;
    wire [DATA_WIDTH-1:0]    cosine_wave;

    // Instantiate the DUT (Device Under Test)
    lut_sincos #(
        .PHASE_WIDTH(PHASE_WIDTH),
        .ADDR_WIDTH (ADDR_WIDTH),
        .DATA_WIDTH (DATA_WIDTH)
    ) dut (
        .clk        (clk),
        .rst        (rst),
        .phase_step (phase_step),
        .sine_wave  (sine_wave),
        .cosine_wave(cosine_wave)
    );

    // Clock generation
    initial begin
        clk = 0;
        forever #(CLK_PERIOD/2) clk = ~clk;
    end

    // Stimulus
    initial begin
        $display("=== LUT_SINCOS Testbench Started (Checking Sine & Cosine Wave) ===");

        rst = 0;           // Assert reset (active-low)
        phase_step = 0;

        #100;
        rst = 1;           // Release reset

        // Set a reasonable frequency ~ 1 kHz (for 50 MHz clock)
        phase_step = 32'd85_899_346;     // ≈ 1 kHz

        $display("Phase Step set for ~1 kHz | Running simulation...");

        // Run long enough to see several cycles of the sine wave
        #500_000;     // 0.5 ms → should see ~500 cycles at 1kHz

        $display("Simulation finished. Check the waveform for sine and cosine.");
        $stop;
    end

    // Optional: Monitor values (uncomment if needed)
    /*
    initial begin
        $monitor("t=%0t | sine=%d | cosine=%d", $time, sine_wave, cosine_wave);
    end
    */

endmodule